FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

convertToMeters 1;

// Circular domain with inner square transitioning to outer circle
// Based on COST732 guidelines for urban CFD domain sizing
//
// Structure:
// - Inner square: Encompasses geometry with small clearance
// - Outer circle: Full domain boundary with adequate clearance
// - Three vertical levels: bottom, middle, top (for vertical stretching)
//
// Geometry center: (6.52, -3.25, 133.11)
// Geometry extent: X: 151.16m, Y: 304.04m, Z: 75.23m
// H = 75.23 m

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
// Domain Parameters

// Inner square side half (encompasses geometry + small clearance)
// Geometry extent: X: 151.16m, Y: 304.04m
// Use max extent + 20% clearance: 304.04 * 1.2 / 2 = ~182m, round to 200m
// Inner square: 400m x 400m centered on geometry

// Outer circle radius (COST732: 5-15H clearance, H = 75.23m)
// Use 10H = 752m, plus geometry half-extent ~200m = ~950m
// Outer circle radius: 950m

// Domain heights
// zBase = 133.11 (ground level from geometry)
// zMid = 300.0 (middle height for stretching)
// zTop = 584.49 (base + 5H clearance = 133.11 + 451.38)

// Cell counts (adjust based on desired resolution)
// Inner square: 40 cells per side
// Inner to outer: 20 cells (radial direction)
// Vertical bottom: 30 cells
// Vertical top: 50 cells

// Stretching ratios
// Radial: 2:1 (inner to outer)
// Vertical: 2:1 (bottom to top)

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

vertices
(
    // Bottom level (z = 133.11)
    // Inner square vertices
    (200.0 -200.0 133.11)   // Vertex s0b = 0   // Inner square +X, -Y
    (-200.0 -200.0 133.11)  // Vertex s1b = 1   // Inner square -X, -Y
    (-200.0 200.0 133.11)   // Vertex s2b = 2   // Inner square -X, +Y
    (200.0 200.0 133.11)    // Vertex s3b = 3   // Inner square +X, +Y
    
    // Outer circle vertices (45 degree points)
    (950.0 0.0 133.11)       // Vertex r0b = 4   // Outer circle +X
    (0.0 -950.0 133.11)      // Vertex r1b = 5   // Outer circle -Y
    (-950.0 0.0 133.11)      // Vertex r2b = 6   // Outer circle -X
    (0.0 950.0 133.11)       // Vertex r3b = 7   // Outer circle +Y

    // Middle level (z = 300.0)
    // Inner square vertices
    (200.0 -200.0 300.0)    // Vertex s0m = 8
    (-200.0 -200.0 300.0)    // Vertex s1m = 9
    (-200.0 200.0 300.0)     // Vertex s2m = 10
    (200.0 200.0 300.0)      // Vertex s3m = 11
    
    // Outer circle vertices
    (950.0 0.0 300.0)        // Vertex r0m = 12
    (0.0 -950.0 300.0)       // Vertex r1m = 13
    (-950.0 0.0 300.0)       // Vertex r2m = 14
    (0.0 950.0 300.0)        // Vertex r3m = 15
    
    // Top level (z = 584.49)
    // Inner square vertices
    (200.0 -200.0 584.49)    // Vertex s0t = 16
    (-200.0 -200.0 584.49)   // Vertex s1t = 17
    (-200.0 200.0 584.49)    // Vertex s2t = 18
    (200.0 200.0 584.49)     // Vertex s3t = 19
    
    // Outer circle vertices
    (950.0 0.0 584.49)       // Vertex r0t = 20
    (0.0 -950.0 584.49)      // Vertex r1t = 21
    (-950.0 0.0 584.49)      // Vertex r2t = 22
    (0.0 950.0 584.49)       // Vertex r3t = 23
);

blocks
(
    // Bottom section: Inner square block
    hex (1 0 3 2 9 8 11 10)
    (40 40 30)
    simpleGrading (1 1 1)
    
    // Bottom section: Four blocks connecting inner square to outer circle
    hex (0 4 7 3 8 12 15 11)   // Block 1: +X direction
    (20 40 30)
    simpleGrading (2 1 1)
    
    hex (3 7 6 2 11 15 14 10)   // Block 2: +Y direction
    (40 20 30)
    simpleGrading (1 2 1)
    
    hex (2 6 5 1 10 14 13 9)    // Block 3: -X direction
    (20 40 30)
    simpleGrading (2 1 1)
    
    hex (1 5 4 0 9 13 12 8)     // Block 4: -Y direction
    (40 20 30)
    simpleGrading (1 2 1)

    // Top section: Inner square block
    hex (9 8 11 10 17 16 19 18)
    (40 40 50)
    simpleGrading (1 1 2)
    
    // Top section: Four blocks connecting inner square to outer circle
    hex (8 12 15 11 16 20 23 19)   // Block 1: +X direction
    (20 40 50)
    simpleGrading (2 1 2)
    
    hex (11 15 14 10 19 23 22 18)   // Block 2: +Y direction
    (40 20 50)
    simpleGrading (1 2 2)
    
    hex (10 14 13 9 18 22 21 17)    // Block 3: -X direction
    (20 40 50)
    simpleGrading (2 1 2)
    
    hex (9 13 12 8 17 21 20 16)     // Block 4: -Y direction
    (40 20 50)
    simpleGrading (1 2 2)
);

edges
(
    // Outer circle arcs (bottom level)
    arc 7 4 (950.0 0.0 133.11)
    arc 4 5 (0.0 -950.0 133.11)
    arc 5 6 (-950.0 0.0 133.11)
    arc 6 7 (0.0 950.0 133.11)
    
    // Outer circle arcs (middle level)
    arc 15 12 (950.0 0.0 300.0)
    arc 12 13 (0.0 -950.0 300.0)
    arc 13 14 (-950.0 0.0 300.0)
    arc 14 15 (0.0 950.0 300.0)

    // Outer circle arcs (top level)
    arc 23 20 (950.0 0.0 584.49)
    arc 20 21 (0.0 -950.0 584.49)
    arc 21 22 (-950.0 0.0 584.49)
    arc 22 23 (0.0 950.0 584.49)
    
    // Inner square arcs (bottom level) - rounded corners
    arc 3 0 (280.0 0.0 133.11)
    arc 0 1 (0.0 -280.0 133.11)
    arc 1 2 (-280.0 0.0 133.11)
    arc 2 3 (0.0 280.0 133.11)

    // Inner square arcs (middle level)
    arc 11 8 (280.0 0.0 300.0)
    arc 8 9 (0.0 -280.0 300.0)
    arc 9 10 (-280.0 0.0 300.0)
    arc 10 11 (0.0 280.0 300.0)
    
    // Inner square arcs (top level)
    arc 19 16 (280.0 0.0 584.49)
    arc 16 17 (0.0 -280.0 584.49)
    arc 17 18 (-280.0 0.0 584.49)
    arc 18 19 (0.0 280.0 584.49)
);

boundary
(
    inletOutlet
    {
        type patch;
        faces
        (
            // Cylindrical wall (outer circle) - bottom section
            (4 7 12 15)
            (5 4 13 12)
            (6 5 14 13)
            (7 6 15 14)
            // Cylindrical wall (outer circle) - top section
            (12 15 23 20)
            (13 12 20 21)
            (14 13 21 22)
            (15 14 22 23)
        );
    }
    
    ground
    {
        type wall;
        faces
        (
            // Bottom surface (inner square + connecting blocks)
            (3 0 1 2)
            (3 7 4 0)
            (2 6 7 3)
            (1 5 6 2)
            (0 4 5 1)
        );
    }
    
    top
    {
        type patch;
        faces
        (
            // Top surface (inner square + connecting blocks)
            (19 18 17 16)
            (19 16 20 23)
            (18 19 23 22)
            (17 18 22 21)
            (16 17 21 20)
        );
    }
);

mergePatchPairs
(
);

// ************************************************************************* //
